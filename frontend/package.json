{
  "name": "safety-training-system",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev:pc": "pnpm --filter @safety-training/pc-web dev",
    "dev:mobile": "pnpm --filter @safety-training/mobile-app dev:h5",
    "build:pc": "pnpm --filter @safety-training/pc-web build",
    "build:mobile": "pnpm --filter @safety-training/mobile-app build:h5",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.9.2",
    "prettier": "^3.9.5",
    "typescript-eslint": "^8.64.0"
  }
}
