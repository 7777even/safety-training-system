{
  "openapi": "3.0.3",
  "info": {
    "title": "素材模块 API 契约",
    "version": "1.0.0",
    "description": "STS 素材域 OpenAPI，覆盖素材 CRUD、异步转码任务调度、处理状态机与删除保护。鉴权：Authorization Bearer {token}；权限码见各 operation 的 x-permission。"
  },
  "servers": [
    {
      "url": "/api",
      "description": "sts-service-admin context path"
    }
  ],
  "paths": {
    "/api/asset/assets": {
      "get": {
        "summary": "分页查询素材",
        "description": "权限：`asset:asset:list`。",
        "tags": [
          "AssetController"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "x-permission": "asset:asset:list",
        "parameters": [
          {
            "name": "pageNum",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          },
          {
            "name": "query.assetName",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "query.assetType",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "DOCUMENT",
                "IMAGE",
                "AUDIO",
                "VIDEO",
                "RICH_TEXT",
                "LINK",
                "LIVE"
              ]
            }
          },
          {
            "name": "query.processStatus",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "UPLOADED",
                "PROCESSING",
                "SUCCEEDED",
                "FAILED"
              ]
            }
          },
          {
            "name": "query.status",
            "in": "query",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResultEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/PageResultAssetListItemVO"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "success",
                  "data": {
                    "list": [
                      {
                        "assetId": 20,
                        "assetCode": "AST-VIDEO-001",
                        "assetName": "消防安全课件",
                        "assetType": "VIDEO",
                        "processStatus": "READY",
                        "status": 1
                      }
                    ],
                    "total": 1
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "post": {
        "summary": "创建素材",
        "description": "权限：`asset:asset:add`。UPLOAD 须有效 fileInfoId；EXTERNAL 须 http(s) URL；CREATED 须 richContent。UPLOAD 原始文件按类型限制：音视频不超过 2GB、文档不超过 512MB、图片不超过 16MB，以后端已登记的 fileInfo 大小为准。AUDIO、VIDEO、原生 PDF 及需转换的 Office 文档只创建 PENDING 异步任务，接口返回时素材保持 UPLOADED；所有 PDF 预览均经 qpdf 线性化后才可用。错误码：6021 校验/编码冲突；6025 原始文件超过类型上限。",
        "tags": [
          "AssetController"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "x-permission": "asset:asset:add",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssetCreateRequest"
              },
              "example": {
                "assetCode": "AST-VIDEO-001",
                "assetName": "消防安全课件",
                "assetType": "VIDEO",
                "sourceType": "UPLOAD",
                "fileInfoId": 200,
                "mimeType": "video/mp4",
                "fileSize": 104857600,
                "durationSeconds": 1800,
                "checksum": "e3b0c44298fc1c149afbf4c8996fb924",
                "status": 1
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "操作成功；data 为 assetId。",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResultEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "integer",
                          "format": "int64"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "success",
                  "data": 20
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/ConflictError"
          }
        }
      }
    },
    "/api/asset/assets/{assetId}": {
      "get": {
        "summary": "查询素材详情",
        "description": "权限：`asset:asset:list`。错误码：6011。",
        "tags": [
          "AssetController"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "x-permission": "asset:asset:list",
        "parameters": [
          {
            "name": "assetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResultEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/AssetVO"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "success",
                  "data": {
                    "assetId": 20,
                    "assetCode": "AST-VIDEO-001",
                    "assetName": "消防安全课件",
                    "assetType": "VIDEO",
                    "sourceType": "FILE",
                    "fileInfoId": 200,
                    "externalUrl": null,
                    "richContent": null,
                    "mimeType": "video/mp4",
                    "fileSize": 104857600,
                    "pageCount": null,
                    "durationSeconds": 1800,
                    "checksum": "e3b0c44298fc1c149afbf4c8996fb924",
                    "processStatus": "READY",
                    "status": 1,
                    "version": 2
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      },
      "put": {
        "summary": "更新素材",
        "description": "权限：`asset:asset:edit`。PROCESSING 状态仅可改名称；不可变更 assetType/sourceType/fileInfoId。错误码：6011、6022、2040。",
        "tags": [
          "AssetController"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "x-permission": "asset:asset:edit",
        "parameters": [
          {
            "name": "assetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssetUpdateRequest"
              },
              "example": {
                "assetName": "消防安全课件（修订）",
                "externalUrl": null,
                "richContent": null,
                "mimeType": "video/mp4",
                "fileSize": 104857600,
                "pageCount": null,
                "durationSeconds": 1800,
                "checksum": "e3b0c44298fc1c149afbf4c8996fb924",
                "status": 1,
                "version": 2
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "操作成功。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultEnvelope"
                },
                "example": {
                  "code": 0,
                  "message": "success",
                  "data": null
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/ConflictError"
          }
        }
      },
      "delete": {
        "summary": "删除素材",
        "description": "权限：`asset:asset:delete`。PROCESSING 不可删；被课程引用不可删。错误码：6011、6022、6023。",
        "tags": [
          "AssetController"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "x-permission": "asset:asset:delete",
        "parameters": [
          {
            "name": "assetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultEnvelope"
                },
                "example": {
                  "code": 0,
                  "message": "success",
                  "data": null
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/ConflictError"
          }
        }
      }
    },
    "/api/asset/assets/{assetId}/retry-transcode": {
      "post": {
        "summary": "重试转码",
        "description": "权限：`asset:asset:edit`。仅 FAILED 状态且存在失败任务的 AUDIO、VIDEO 或需转换文档可人工重试；调用后任务重置为 PENDING，由调度器异步执行。错误码：6011、6022、6024。",
        "tags": [
          "AssetController"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "x-permission": "asset:asset:edit",
        "parameters": [
          {
            "name": "assetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultEnvelope"
                },
                "example": {
                  "code": 0,
                  "message": "success",
                  "data": null
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      }
    },
    "/api/asset/assets/{assetId}/play-info": {
      "get": {
        "summary": "获取素材播放预览信息",
        "description": "权限：`asset:asset:list`。仅返回当前租户且处理成功的素材；地址为受控后端代理，不暴露 MinIO 信息。format 为闭合枚举，取值含义见 AssetPlayInfoVO.format。已转码视频与已转码音频均为 `hls`（音频无封面）。外链（EXTERNAL）与富文本（CREATED）素材没有可播文件，返回 404。错误码：6011。",
        "tags": [
          "AssetMediaController"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "x-permission": "asset:asset:list",
        "parameters": [
          {
            "name": "assetId",
            "in": "path",
            "required": true,
            "description": "素材 ID。",
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResultEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/AssetPlayInfoVO"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "success",
                  "data": {
                    "assetId": 20,
                    "format": "hls",
                    "url": "/api/asset/files/20/hls/9/index.m3u8",
                    "coverUrl": "/api/asset/files/20/301",
                    "durationSeconds": 120,
                    "pageCount": null
                  }
                },
                "examples": {
                  "videoHls": {
                    "summary": "已转码视频",
                    "value": {
                      "code": 0,
                      "message": "success",
                      "data": {
                        "assetId": 20,
                        "format": "hls",
                        "url": "/api/asset/files/20/hls/9/index.m3u8",
                        "coverUrl": "/api/asset/files/20/301",
                        "durationSeconds": 120,
                        "pageCount": null
                      }
                    }
                  },
                  "audioHls": {
                    "summary": "已转码音频（无封面）",
                    "value": {
                      "code": 0,
                      "message": "success",
                      "data": {
                        "assetId": 21,
                        "format": "hls",
                        "url": "/api/asset/files/21/hls/10/index.m3u8",
                        "coverUrl": null,
                        "durationSeconds": 186,
                        "pageCount": null
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      }
    },
    "/api/asset/files/{assetId}/{fileInfoId}": {
      "get": {
        "summary": "读取受控素材文件",
        "description": "权限：`asset:asset:list`。校验素材机构归属和文件关联；支持单一 bytes Range。完整请求 200，合法区间 206，非法、多区间或越界 416。",
        "tags": [
          "AssetMediaController"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "x-permission": "asset:asset:list",
        "parameters": [
          {
            "name": "assetId",
            "in": "path",
            "required": true,
            "description": "素材 ID。",
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 20
            }
          },
          {
            "name": "fileInfoId",
            "in": "path",
            "required": true,
            "description": "与素材关联的源文件或派生文件 ID。",
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 301
            }
          },
          {
            "name": "Range",
            "in": "header",
            "required": false,
            "description": "单一字节区间。",
            "schema": {
              "type": "string",
              "example": "bytes=0-1023"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "完整文件字节流。"
          },
          "206": {
            "description": "区间文件字节流。"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "416": {
            "description": "Range 非法、多区间或越界。"
          }
        }
      }
    },
    "/api/asset/files/{assetId}/hls/{jobId}/{name}": {
      "get": {
        "summary": "读取受控 HLS 文件",
        "description": "权限：`asset:asset:list`。仅允许已登记 HLS 派生目录内的 index.m3u8 或规范 TS 分片名，使用与素材相同的机构权限边界。视频与音频转码成功后的 HLS 均走本接口。",
        "tags": [
          "AssetMediaController"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "x-permission": "asset:asset:list",
        "parameters": [
          {
            "name": "assetId",
            "in": "path",
            "required": true,
            "description": "素材 ID。",
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 20
            }
          },
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "description": "生成该 HLS 的转码任务 ID。",
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 9
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "HLS 清单或分片文件名。",
            "schema": {
              "type": "string",
              "example": "segment-00000.ts"
            }
          },
          {
            "name": "Range",
            "in": "header",
            "required": false,
            "description": "单一字节区间。",
            "schema": {
              "type": "string",
              "example": "bytes=0-1023"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "完整 HLS 文件。"
          },
          "206": {
            "description": "区间 HLS 文件。"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "416": {
            "description": "Range 非法、多区间或越界。"
          }
        }
      }
    },
    "/api/asset/transcode-jobs": {
      "get": {
        "summary": "查询转码任务列表",
        "description": "权限：`asset:job:list`。可选按 assetId 和 jobStatus 过滤。",
        "tags": [
          "AssetController"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "x-permission": "asset:job:list",
        "parameters": [
          {
            "name": "assetId",
            "in": "query",
            "required": false,
            "description": "素材 ID。",
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 20
            }
          },
          {
            "name": "jobStatus",
            "in": "query",
            "required": false,
            "description": "任务状态。",
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "RUNNING",
                "SUCCEEDED",
                "FAILED"
              ],
              "example": "FAILED"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResultEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/AssetTranscodeJobListItemVO"
                          }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "message": "success",
                  "data": [
                    {
                      "transcodeJobId": 1,
                      "assetId": 20,
                      "jobType": "VIDEO_TRANSCODE",
                      "jobStatus": "SUCCEEDED",
                      "startedTime": "2026-07-18T10:00:00",
                      "finishedTime": "2026-07-18T10:05:00",
                      "retryCount": 0,
                      "failureCode": null,
                      "failureReason": null,
                      "createTime": "2026-07-18T09:59:00"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "UUID",
        "description": "受保护接口须在 Authorization 请求头中传递 Bearer {token}。"
      }
    },
    "responses": {
      "ValidationError": {
        "description": "请求参数校验失败。",
        "content": {
          "application/json": {
            "example": {
              "code": 1001,
              "message": "参数校验失败",
              "data": null
            }
          }
        }
      },
      "Unauthorized": {
        "description": "未登录或登录已失效。",
        "content": {
          "application/json": {
            "example": {
              "code": 1002,
              "message": "未登录",
              "data": null
            }
          }
        }
      },
      "Forbidden": {
        "description": "缺少接口所需权限。",
        "content": {
          "application/json": {
            "example": {
              "code": 1003,
              "message": "权限不足",
              "data": null
            }
          }
        }
      },
      "NotFoundError": {
        "description": "素材、任务或关联文件不存在，或不属于当前机构。",
        "content": {
          "application/json": {
            "example": {
              "code": 6011,
              "message": "素材或媒体文件不存在",
              "data": null
            }
          }
        }
      },
      "ConflictError": {
