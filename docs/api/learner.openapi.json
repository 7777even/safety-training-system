    "/api/learner/messages/stream": {
      "get": {
        "tags": [
          "LearnerController"
        ],
        "summary": "在线推送本人消息变化",
        "description": "SSE原始流，不包装Result。Authorization携带Bearer令牌，禁止令牌放入URL。3秒检查在线接收人的已提交消息变化；messages事件data为JSON总数，客户端重新读取本人消息列表。心跳为SSE注释。每次重连均补发当前数量，不使用自增ID推断提交顺序。连接过期/退出后关闭；断线重连，离线仍可查持久化列表。代理需要保持流式响应且不缓存、不缓冲。仅PC/H5，不提供微信/App系统推送。1002未登录；4050租户缺失。",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "x-permission": "LOGIN",
        "responses": {
          "200": {
            "description": "持续SSE变化及心跳",
            "headers": {
              "Cache-Control": {
                "description": "禁止缓存",
                "schema": {
                  "type": "string"
                },
                "example": "no-store"
              },
              "X-Accel-Buffering": {
                "description": "代理关闭缓冲",
                "schema": {
                  "type": "string"
                },
                "example": "no"
              }
            },
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "标准SSE帧"
                },
                "example": "event:messages\ndata:{\"total\":2}\n\n:heartbeat\n\n"
              }
            }
          },
          "401": {
            "description": "未登录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": 1002,
                  "message": "未登录",
                  "data": null
                }
              }
            }
          },
          "500": {
            "description": "租户上下文缺失",
