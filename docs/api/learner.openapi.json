  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "当前登录会话令牌"
      }
    },
    "schemas": {
      "LearnerHomeTask": {
        "type": "object",
        "description": "本人首页任务摘要",
        "required": [
          "key",
          "kind",
          "title",
          "status",
          "resourceId"
        ],
        "properties": {
          "key": {
            "type": "string",
            "description": "来源与ID组成的任务标识"
          },
          "kind": {
            "type": "string",
            "description": "业务来源类型",
            "enum": [
              "COURSE",
              "FORMAL_EXAM",
              "COURSE_QUIZ",
              "TRAINING",
              "COURSE_CATALOG"
            ]
          },
          "title": {
            "type": "string",
            "description": "真实任务名称"
          },
          "status": {
            "type": "string",
            "description": "原来源业务状态"
          },
          "action": {
            "type": "string",
            "description": "沿用原领域动作：VIEW_COURSE/VIEW_TRAINING/START/CONTINUE/WAIT_REVIEW/VIEW_RESULT；无动作为空",
            "nullable": true
          },
          "resourceId": {
            "type": "integer",
            "description": "业务主引用，不同来源ID不能混用",
            "format": "int64"
          },
          "parentId": {
            "type": "integer",
            "description": "父业务引用；正式考试为考试ID，其余可空",
            "format": "int64",
            "nullable": true
          },
          "itemId": {
            "type": "integer",
            "description": "课程测验内容项ID，其余为空",
            "format": "int64",
            "nullable": true
          },
          "endTime": {
            "type": "string",
            "description": "课程/培训截止时间；考核未提供时为空",
            "format": "date-time",
            "nullable": true
          },
          "attemptId": {
            "type": "integer",
            "format": "int64",
            "nullable": true,
            "description": "原领域允许回看的当前考卷ID"
          }
        }
      },
      "LearnerMessage": {
        "type": "object",
        "description": "本人站内消息；来源失效后仍保留",
        "required": [
          "recipientId",
          "messageId",
          "kind",
          "title",
          "content",
          "resourceId",
          "createTime"
        ],
        "properties": {
          "recipientId": {
            "type": "integer",
            "description": "实际投递主键",
            "format": "int64"
          },
          "messageId": {
            "type": "integer",
            "description": "消息主键",
            "format": "int64"
          },
          "kind": {
            "type": "string",
            "description": "业务来源类型",
            "enum": [
              "COURSE",
              "FORMAL_EXAM",
              "COURSE_QUIZ",
              "TRAINING",
              "COURSE_CATALOG"
            ]
          },
          "title": {
            "type": "string",
            "description": "消息标题"
          },
          "content": {
            "type": "string",
            "description": "通知正文"
          },
          "resourceId": {
            "type": "integer",
            "description": "业务主引用，不同来源ID不能混用",
            "format": "int64"
          },
          "parentId": {
            "type": "integer",
            "description": "父业务引用；正式考试为考试ID，其余可空",
            "format": "int64",
            "nullable": true
          },
          "itemId": {
            "type": "integer",
            "description": "课程测验内容项ID，其余为空",
            "format": "int64",
            "nullable": true
          },
          "createTime": {
            "type": "string",
            "description": "服务端生成时间",
            "format": "date-time"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "description": "统一业务错误",
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "description": "业务错误码"
          },
          "message": {
            "type": "string",
            "description": "中文错误说明"
          },
          "data": {
            "type": "object",
            "description": "失败时为空",
            "nullable": true
          }
        }
      },
      "HomePage": {
        "type": "object",
        "description": "标准本人分页结果",
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "description": "成功为0"
          },
          "message": {
            "type": "string",
            "description": "响应说明"
          },
          "data": {
            "type": "object",
            "description": "分页数据",
            "required": [
              "list",
              "total"
            ],
            "properties": {
              "list": {
                "type": "array",
                "description": "当前页记录",
                "items": {
                  "$ref": "#/components/schemas/LearnerHomeTask"
                }
              },
              "total": {
                "type": "integer",
                "description": "符合条件记录总数",
                "format": "int64"
              }
            }
          }
        }
      },
      "MessagePage": {
        "type": "object",
        "description": "标准本人分页结果",
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "description": "成功为0"
          },
          "message": {
            "type": "string",
            "description": "响应说明"
          },
          "data": {
            "type": "object",
            "description": "分页数据",
            "required": [
              "list",
              "total"
            ],
            "properties": {
              "list": {
                "type": "array",
                "description": "当前页记录",
                "items": {
                  "$ref": "#/components/schemas/LearnerMessage"
                }
              },
              "total": {
                "type": "integer",
                "description": "符合条件记录总数",
                "format": "int64"
              }
            }
          }
        }
      },
      "HistorySummary": {
        "type": "object",
        "description": "原始记录或档案展示摘要，成绩沿用本人可见规则",
        "properties": {
          "userName": {
            "type": "string",
            "description": "历史身份姓名展示",
            "nullable": true
          },
          "userCode": {
            "type": "string",
            "description": "历史账号展示",
            "nullable": true
          },
          "occurredTime": {
            "type": "string",
            "description": "发生时间",
            "format": "date-time",
            "nullable": true
          },
          "status": {
            "type": "string",
            "description": "来源领域状态"
          },
          "score": {
            "type": "number",
            "description": "已允许公开的成绩；未公开或不评分为空",
            "nullable": true
          },
          "hours": {
            "type": "number",
            "description": "已有学时；不适用为空",
            "nullable": true
          },
          "scoreVisible": {
            "type": "boolean",
            "description": "原领域是否允许公开成绩"
          }
        }
      },
      "HistoryReference": {
        "type": "object",
        "description": "受控原入口引用，两端映射现有路由，目标接口重新鉴权",
        "properties": {
          "kind": {
            "type": "string",
            "description": "原入口业务类型",
            "enum": [
              "COURSE",
              "FORMAL_EXAM",
              "COURSE_QUIZ",
              "TRAINING",
              "PRACTICE",
              "SIMULATION"
            ]
          },
          "resourceId": {
            "type": "integer",
            "description": "入口资源主键",
            "format": "int64"
          },
          "parentId": {
            "type": "integer",
            "description": "父考试或计划主键",
            "format": "int64",
            "nullable": true
          },
          "itemId": {
            "type": "integer",
            "description": "课程内容项",
            "format": "int64",
            "nullable": true
          },
          "attemptId": {
            "type": "integer",
            "description": "原答卷主键",
            "format": "int64",
            "nullable": true
          },
          "action": {
            "type": "string",
            "description": "原入口动作",
            "nullable": true
          }
        }
      },
      "HistoryCorrection": {
        "type": "object",
        "description": "不可覆盖的追加更正；本人轨迹不返回尚未公开的score前后值",
        "properties": {
          "correctionId": {
            "type": "integer",
            "description": "更正主键",
            "format": "int64"
          },
          "version": {
            "type": "integer",
            "description": "展示版本"
          },
          "before": {
            "type": "object",
            "description": "修改字段在上一个展示版本的前值",
            "additionalProperties": {
              "nullable": true
            }
          },
          "after": {
            "type": "object",
            "description": "本次修改字段后值",
            "additionalProperties": {
              "nullable": true
            }
          },
          "reason": {
            "type": "string",
            "description": "更正理由"
          },
          "operatorId": {
            "type": "integer",
            "description": "操作人主键",
            "format": "int64"
          },
          "operatorName": {
            "type": "string",
            "description": "操作人姓名快照",
            "nullable": true
          },
          "operatedTime": {
            "type": "string",
            "description": "操作时间",
            "format": "date-time"
          }
        }
      },
      "LearnerHistory": {
        "type": "object",
        "description": "原始记录与档案更正分开展示，禁止冒充正式计算结果",
        "properties": {
          "recordType": {
            "type": "string",
            "description": "历史来源",
            "enum": [
              "COURSE",
              "FORMAL_EXAM",
              "COURSE_QUIZ",
              "PRACTICE",
              "SIMULATION",
              "TRAINING"
            ]
          },
          "recordId": {
            "type": "integer",
            "description": "来源记录主键",
            "format": "int64"
          },
          "title": {
            "type": "string",
            "description": "来源名称"
          },
          "original": {
            "$ref": "#/components/schemas/HistorySummary"
          },
          "current": {
            "$ref": "#/components/schemas/HistorySummary"
          },
          "version": {
            "type": "integer",
            "description": "当前展示版本，原始为0"
          },
          "reference": {
            "$ref": "#/components/schemas/HistoryReference"
          },
          "corrections": {
            "type": "array",
            "description": "详情更正轨迹；列表返回空数组",
            "items": {
              "$ref": "#/components/schemas/HistoryCorrection"
            }
          }
        }
      },
      "HistoryCorrectionRequest": {
        "type": "object",
        "description": "只追加摘要更正，不修改原记录/冻结资产，不重算",
        "required": [
          "version",
          "changes",
          "reason"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "description": "读取的当前展示版本",
            "minimum": 0
          },
          "changes": {
            "type": "object",
            "description": "userName/userCode文本、occurredTime日期时间、领域status、适用的score/hours数值或null；其余拒绝",
            "minProperties": 1,
            "maxProperties": 6,
            "additionalProperties": {
              "nullable": true
            }
          },
          "reason": {
            "type": "string",
            "description": "非空更正依据",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}
