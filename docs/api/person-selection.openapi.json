{
  "openapi": "3.0.3",
  "info": {
    "title": "统一人员选择 API 契约",
    "version": "1.0.0",
    "description": "提供当前机构候选人员、手工特征、只读培训事实及固定条件用户组；部门、岗位、标签等同字段取并集、不同字段取交集。任务下发当次展开，不动态修改已有名单。"
  },
  "servers": [
    {
      "url": "/api",
      "description": "sts-service-admin context path"
    }
  ],
  "tags": [
    {
      "name": "PersonPickerController",
      "description": "统一人员选择候选人查询接口。"
    },
    {
      "name": "PersonClassificationController",
      "description": "人员特征、条件分类与用户组管理"
    }
  ],
  "paths": {
    "/api/common/person-picker": {
      "get": {
        "summary": "分页查询当前机构候选人员",
        "description": "权限：`common:person:list`。只返回当前机构启用用户；部门条件包含全部下级部门。 支持岗位及用户组成员筛选，与部门、姓名条件取交集。无有效成员时明确提示4111/4120。 人员选择错误码：4111（岗位/人员选择无效或无启用成员）、4120（用户组不存在、停用、跨租户或当前无成员）。",
        "tags": [
          "PersonPickerController"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "x-permission": "common:person:list",
        "parameters": [
          {
            "name": "pageNum",
            "in": "query",
            "required": false,
            "description": "页码，从 1 开始。",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "example": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "每页数量。",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10,
              "example": 10
            }
          },
          {
            "name": "query.keyword",
            "in": "query",
            "required": false,
            "description": "按工号、姓名或手机号模糊查询。",
            "schema": {
              "type": "string",
              "example": "张三"
            }
          },
          {
            "name": "query.deptId",
            "in": "query",
            "required": false,
            "description": "部门 ID，包含下级部门。",
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 10
            }
          },
          {
            "name": "query.positionId",
            "in": "query",
            "description": "按当前有效岗位成员筛选",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1,
              "example": 1
            }
          },
          {
            "name": "query.groupId",
            "in": "query",
            "description": "按条件组当前成员筛选；空组、停用或跨租户组明确报错4120",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1,
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultPersonPickerPage"
                },
                "example": {
                  "code": 0,
                  "message": "success",
                  "data": {
                    "list": [
                      {
                        "userId": 8,
                        "userCode": "E008",
                        "userName": "张三",
                        "organizationId": 1,
                        "deptId": 10,
                        "deptName": "生产部",
                        "memberType": "INTERNAL",
                        "jobTitle": "安全员",
                        "status": 1
                      }
                    ],
                    "total": 1
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数错误。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                },
                "example": {
                  "code": 1001,
                  "message": "参数错误",
                  "data": null
                }
              }
            }
          },
          "401": {
            "description": "未登录。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                },
                "example": {
                  "code": 1002,
                  "message": "未登录",
                  "data": null
                }
              }
            }
          },
          "403": {
            "description": "无权限。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                },
                "example": {
                  "code": 1003,
                  "message": "无权限",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
